                "http://${PUBLIC_HOST}:${OPEN_WEBUI_HTTP_HOST_PORT:-32000}"
            ],
            "protocolMappers": [
                {
                    "name": "groups",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-group-membership-mapper",
                    "consentRequired": false,
                    "config": {
                        "claim.name": "groups",
                        "full.path": "false",
