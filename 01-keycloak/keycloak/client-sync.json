            "clientAuthenticatorType": "client-secret",
            "secret": "${OPEN_WEBUI_OIDC_CLIENT_SECRET:-open-webui-oauth-client-secret-key}",
            "standardFlowEnabled": true,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "rootUrl": "http://${PUBLIC_HOST}:${OPEN_WEBUI_HTTP_HOST_PORT:-32000}/",
            "redirectUris": [
                "http://localhost:${OPEN_WEBUI_HTTP_HOST_PORT:-32000}/oauth/oidc/callback",
                "http://127.0.0.1:${OPEN_WEBUI_HTTP_HOST_PORT:-32000}/oauth/oidc/callback",
                "http://${PUBLIC_HOST}:${OPEN_WEBUI_HTTP_HOST_PORT:-32000}/oauth/oidc/callback"
