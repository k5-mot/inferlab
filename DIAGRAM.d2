users -> public_host: "access"
public_host -> service_catalog: "published services"

service_catalog.row_1.00_common.keycloak -> service_catalog.row_1.00_common.oidc: "auth"
service_catalog.row_1.00_common.oidc -> service_catalog.row_1.11_webui.open_webui: "OIDC"
service_catalog.row_1.00_common.oidc -> service_catalog.row_2.12_storage.nextcloud: "OIDC"
service_catalog.row_1.00_common.oidc -> service_catalog.row_2.20_team_chat.zulip: "OIDC"
service_catalog.row_1.00_common.oidc -> service_catalog.row_2.21_team_project.leantime: "OIDC"
service_catalog.row_1.00_common.oidc -> service_catalog.row_2.22_team_wiki.bookstack: "OIDC"
service_catalog.row_1.00_common.oidc -> service_catalog.row_3.50_o11y.grafana: "OIDC"
service_catalog.row_1.00_common.oidc -> service_catalog.row_3.51_llmops.langfuse: "OIDC"

service_catalog.row_1.00_common.keycloak -> service_catalog.row_3.50_o11y.metrics: "metrics" {
  style.stroke-dash: 4
}
service_catalog.row_1.01_infra.couchdb -> service_catalog.row_3.50_o11y.metrics: "metrics" {
  style.stroke-dash: 4
}
service_catalog.row_1.10_inference.litellm -> service_catalog.row_3.50_o11y.metrics: "metrics" {
  style.stroke-dash: 4
}
service_catalog.row_1.11_webui.open_webui -> service_catalog.row_3.50_o11y.metrics: "OTLP metrics" {
  style.stroke-dash: 4
}
service_catalog.row_1.11_webui.searxng -> service_catalog.row_3.50_o11y.metrics: "metrics" {
  style.stroke-dash: 4
}
service_catalog.row_2.12_storage.nextcloud -> service_catalog.row_3.50_o11y.metrics: "metrics" {
  style.stroke-dash: 4
}
service_catalog.row_3.23_team_git.gitea -> service_catalog.row_3.50_o11y.metrics: "metrics" {
  style.stroke-dash: 4
}
service_catalog.row_3.51_llmops.langfuse -> service_catalog.row_3.50_o11y.metrics: "metrics" {
  style.stroke-dash: 4
}
service_catalog.row_3.50_o11y.metrics -> service_catalog.row_3.50_o11y.prometheus: "scrape / push" {
  style.stroke-dash: 4
}
service_catalog.row_3.50_o11y.prometheus -> service_catalog.row_3.50_o11y.grafana: "datasource"

service_catalog.row_1.10_inference.litellm -> service_catalog.row_1.10_inference.ollama: "chat models"
service_catalog.row_1.10_inference.litellm -> service_catalog.row_1.10_inference.tei: "embedding / reranking"
service_catalog.row_1.10_inference.litellm -> service_catalog.row_1.10_inference.openrouter: "external LLM API"
service_catalog.row_1.10_inference.litellm -> service_catalog.row_1.10_inference.google_ai_studio: "external LLM API"
service_catalog.row_1.10_inference.litellm -> service_catalog.row_3.51_llmops.langfuse: "LLM traces"
service_catalog.row_1.10_inference.hermes_agent -> service_catalog.row_1.10_inference.litellm: "LLM API"

service_catalog.row_1.11_webui.open_webui -> service_catalog.row_1.10_inference.litellm: "LLM / RAG API"
service_catalog.row_1.11_webui.open_webui -> service_catalog.row_1.10_inference.hermes_agent: "agent API"
service_catalog.row_1.11_webui.open_webui -> service_catalog.row_1.11_webui.integrations: "uses"
service_catalog.row_1.11_webui.integrations -> service_catalog.row_1.11_webui.open_terminal: "terminal"
service_catalog.row_1.11_webui.integrations -> service_catalog.row_1.11_webui.docling: "content extraction"
