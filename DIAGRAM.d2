vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 101
  }
}

direction: down

users: {
  label: "Users"
  shape: person
  style: {
    fill: "#f8fafc"
    stroke: "#475569"
  }
}

public_host: {
  label: "PUBLIC_HOST"
