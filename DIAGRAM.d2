}

users -> public_host: "access"
public_host -> service_catalog.row_1: "platform / developer entrypoints"
public_host -> service_catalog.row_2: "application entrypoints"
public_host -> service_catalog.row_3: "dashboard entrypoints"

service_catalog.row_1 -> service_catalog.row_2: "OIDC / infrastructure / repositories"
service_catalog.row_2 -> service_catalog.row_3: "metrics / LLM traces"
service_catalog.row_1 -> service_catalog.row_3: "platform metrics"
