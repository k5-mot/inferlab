vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 101
  }
}

direction: down

users: {
  label: "Users"
  shape: person
  style: {
    fill: "#f8fafc"
    stroke: "#475569"
  }
}

public_host: {
  label: "PUBLIC_HOST"
  style: {
    fill: "#eef2ff"
    stroke: "#4f46e5"
    stroke-width: 2
  }
}

note: {
  label: "README 向けサービス一覧\n内部 DB / Redis / worker / proxy / exporter は省略\n矢印は認証・監視・LLMOps の代表的な情報流だけを表示"
  style: {
    fill: "#fffbeb"
    stroke: "#d97706"
  }
}

service_catalog: {
  label: "InferLab user-facing services"
  direction: down
  grid-columns: 1
  style: {
    fill: "#f8fafc"
    stroke: "#334155"
    stroke-width: 2
  }

  row_1: {
    label: "Foundation / Inference / Web UI"
    direction: right
    grid-columns: 4
    style: {
      fill: "#ffffff"
      stroke: "#cbd5e1"
    }

    00_common: {
      label: "00-common"
      grid-columns: 2
      style: {
        fill: "#f0fdfa"
        stroke: "#0f766e"
        stroke-width: 2
      }

      homepage: {
        label: "Homepage\n30000"
        icon: "./00-common/homepage/icons/homepage.png"
        style: {
          fill: "#ffffff"
          stroke: "#0f766e"
        }
      }

      keycloak: {
        label: "Keycloak\n30001 / 30002"
        icon: "./00-common/homepage/icons/keycloak.png"
        style: {
          fill: "#ffffff"
          stroke: "#0f766e"
        }
      }

      oidc: {
        label: "OIDC"
        style: {
          fill: "#ccfbf1"
          stroke: "#0f766e"
          stroke-dash: 4
        }
      }
    }

    01_infra: {
      label: "01-infra"
      grid-columns: 2
      style: {
        fill: "#eef2ff"
        stroke: "#4f46e5"
        stroke-width: 2
      }

      cloudflare: {
        label: "Cloudflare Tunnel"
        icon: "./00-common/homepage/icons/cloudflared.png"
        style: {
          fill: "#ffffff"
          stroke: "#4f46e5"
        }
      }

      couchdb: {
        label: "CouchDB\n30100"
        icon: "./00-common/homepage/icons/couchdb.png"
        style: {
          fill: "#ffffff"
          stroke: "#4f46e5"
        }
      }
    }

    10_inference: {
      label: "10-inference"
      grid-columns: 3
      style: {
        fill: "#fefce8"
        stroke: "#a16207"
        stroke-width: 2
      }

      litellm: {
        label: "LiteLLM\n31000"
        icon: "./00-common/homepage/icons/litlellm.png"
        style: {
          fill: "#ffffff"
          stroke: "#a16207"
        }
      }

      ollama: {
        label: "Ollama"
        icon: "./00-common/homepage/icons/ollama.png"
        style: {
          fill: "#ffffff"
          stroke: "#a16207"
        }
      }

      tei: {
        label: "TEI\nEmbedding / Reranking"
        icon: "./00-common/homepage/icons/hugging-face.png"
        style: {
          fill: "#ffffff"
          stroke: "#a16207"
        }
      }

      openrouter: {
        label: "OpenRouter\n外部サービス"
        icon: "./00-common/homepage/icons/open-router.png"
        shape: cloud
        style: {
          fill: "#f8fafc"
          stroke: "#64748b"
          stroke-dash: 4
        }
      }

      google_ai_studio: {
        label: "Google AI Studio\n外部サービス"
        icon: "./00-common/homepage/icons/google-gemini.png"
        shape: cloud
        style: {
          fill: "#f8fafc"
          stroke: "#64748b"
          stroke-dash: 4
        }
      }

      hermes_agent: {
        label: "Hermes-Agent\n31001"
        icon: "./00-common/homepage/icons/hermes-icon.png"
        style: {
          fill: "#ffffff"
          stroke: "#a16207"
        }
      }
    }

    11_webui: {
      label: "11-webui"
      grid-columns: 3
      style: {
        fill: "#eff6ff"
        stroke: "#2563eb"
        stroke-width: 2
      }

      open_webui: {
        label: "Open WebUI\n31100"
        icon: "./00-common/homepage/icons/open-webui.png"
        style: {
          fill: "#ffffff"
          stroke: "#2563eb"
        }
      }

      open_terminal: {
        label: "Open Terminal\n31103"
        icon: "./00-common/homepage/icons/open-webui.png"
        style: {
          fill: "#ffffff"
          stroke: "#2563eb"
        }
      }

      docling: {
        label: "docling-serve\n31101"
        icon: "./00-common/homepage/icons/docling.png"
        style: {
          fill: "#ffffff"
          stroke: "#2563eb"
        }
      }

      searxng: {
        label: "SearXNG\n31102"
        icon: "./00-common/homepage/icons/searxng.png"
        style: {
          fill: "#ffffff"
          stroke: "#2563eb"
        }
      }

      qdrant: {
        label: "Qdrant"
        icon: "./00-common/homepage/icons/qdrant.png"
        style: {
          fill: "#ffffff"
          stroke: "#2563eb"
        }
      }

      voicevox_tts: {
        label: "VOICEVOX TTS"
        icon: "./00-common/homepage/icons/volume-high.png"
        style: {
          fill: "#ffffff"
          stroke: "#2563eb"
        }
      }

      integrations: {
        label: "integrations"
        style: {
          fill: "#dbeafe"
          stroke: "#2563eb"
          stroke-dash: 4
        }
      }
    }
  }

  row_2: {
    label: "Storage / Automation / Collaboration"
    direction: right
    grid-columns: 5
    style: {
      fill: "#ffffff"
      stroke: "#cbd5e1"
    }

    12_storage: {
      label: "12-storage"
      grid-columns: 2
      style: {
        fill: "#ecfdf5"
        stroke: "#059669"
        stroke-width: 2
      }

      nextcloud: {
        label: "Nextcloud\n31200"
        icon: "./00-common/homepage/icons/nextcloud.png"
        style: {
          fill: "#ffffff"
          stroke: "#059669"
        }
      }

      oikb: {
        label: "Open-WebUI Knowledge Bases\n31201"
        icon: "./00-common/homepage/icons/open-webui.png"
        style: {
          fill: "#ffffff"
          stroke: "#059669"
        }
      }
    }

    13_automation: {
      label: "13-automation"
      style: {
        fill: "#fff7ed"
        stroke: "#ea580c"
        stroke-width: 2
      }

      dify: {
        label: "Dify\n31300"
        icon: "./00-common/homepage/icons/dify.png"
        style: {
          fill: "#ffffff"
          stroke: "#ea580c"
        }
      }
    }

    20_team_chat: {
      label: "20-team-chat"
      style: {
        fill: "#fdf2f8"
        stroke: "#db2777"
        stroke-width: 2
      }

      zulip: {
        label: "Zulip\n32000 / 32002 / 32025"
        icon: "./00-common/homepage/icons/zulip.png"
        style: {
          fill: "#ffffff"
          stroke: "#db2777"
        }
      }
    }

    21_team_project: {
      label: "21-team-project"
      style: {
        fill: "#f5f3ff"
        stroke: "#7c3aed"
        stroke-width: 2
      }

      leantime: {
        label: "Leantime\n32001"
        icon: "./00-common/homepage/icons/leantime.png"
        style: {
          fill: "#ffffff"
          stroke: "#7c3aed"
        }
      }
    }

    22_team_wiki: {
      label: "22-team-wiki"
      style: {
        fill: "#f8fafc"
        stroke: "#475569"
        stroke-width: 2
      }

      bookstack: {
        label: "BookStack\n32200"
        icon: "./00-common/homepage/icons/bookstack.png"
        style: {
          fill: "#ffffff"
          stroke: "#475569"
        }
      }
    }
  }

  row_3: {
    label: "Git / Developer / Observability / LLMOps"
    direction: right
    grid-columns: 4
    style: {
      fill: "#ffffff"
      stroke: "#cbd5e1"
    }

    23_team_git: {
      label: "23-team-git"
      style: {
        fill: "#fef2f2"
        stroke: "#dc2626"
        stroke-width: 2
      }

      gitea: {
        label: "Gitea\n32300 / 32322"
        icon: "./00-common/homepage/icons/gitea.png"
        style: {
          fill: "#ffffff"
          stroke: "#dc2626"
        }
      }
    }

    30_developer: {
      label: "30-developer"
      grid-columns: 3
      style: {
        fill: "#f0f9ff"
        stroke: "#0284c7"
        stroke-width: 2
      }

      pypiserver: {
        label: "PyPI\n33100"
        icon: "./00-common/homepage/icons/pypi.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
        }
      }

      verdaccio: {
        label: "Verdaccio\n33200"
        icon: "./00-common/homepage/icons/verdaccio.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
        }
      }

      code_marketplace: {
        label: "Code Marketplace\n33300"
        icon: "./00-common/homepage/icons/visual-studio-code.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
        }
      }

      rpm_repo: {
        label: "RPM Repository\n33400"
        icon: "./00-common/homepage/icons/redhat-linux.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
