    20_team_chat: {
      label: "20-team-chat"
      style: {
        fill: "#fdf2f8"
        stroke: "#db2777"
        stroke-width: 2
      }

      zulip: {
        label: "Zulip\n32000 / 32002 / 32025"
        icon: "./00-common/homepage/icons/zulip.png"
        style: {
          fill: "#ffffff"
          stroke: "#db2777"
        }
      }
    }

    21_team_project: {
      label: "21-team-project"
      style: {
        fill: "#f5f3ff"
