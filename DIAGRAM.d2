      leantime: {
        label: "Leantime\n32001"
        icon: "./00-common/homepage/icons/leantime.png"
        style: {
          fill: "#ffffff"
          stroke: "#7c3aed"
        }
      }
    }

    22_team_wiki: {
      label: "22-team-wiki"
      style: {
        fill: "#f8fafc"
        stroke: "#475569"
        stroke-width: 2
      }

      bookstack: {
        label: "BookStack\n32200"
        icon: "./00-common/homepage/icons/bookstack.png"
        style: {
          fill: "#ffffff"
          stroke: "#475569"
        }
      }
    }

    23_team_git: {
      label: "23-team-git"
      style: {
        fill: "#fef2f2"
        stroke: "#dc2626"
        stroke-width: 2
      }

      gitea: {
        label: "Gitea\n32300 / 32322"
        icon: "./00-common/homepage/icons/gitea.png"
        style: {
          fill: "#ffffff"
          stroke: "#dc2626"
        }
      }
    }
  }

  row_3: {
    label: "Observability Layer"
    direction: right
    grid-columns: 2
    style: {
      fill: "#ffffff"
      stroke: "#cbd5e1"
    }

    50_o11y: {
      label: "50-o11y"
      grid-columns: 2
      style: {
        fill: "#ecfeff"
        stroke: "#0891b2"
        stroke-width: 2
      }

      grafana: {
        label: "Grafana\n35000"
        icon: "./00-common/homepage/icons/grafana.png"
