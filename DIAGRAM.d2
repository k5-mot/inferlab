          fill: "#ffffff"
          stroke: "#2563eb"
        }
      }

      voicevox_tts: {
        label: "VOICEVOX TTS"
        icon: "./00-common/homepage/icons/volume-high.png"
        style: {
          fill: "#ffffff"
          stroke: "#2563eb"
        }
      }
    }

    12_storage: {
      label: "12-storage"
      grid-columns: 2
      style: {
        fill: "#ecfdf5"
        stroke: "#059669"
        stroke-width: 2
      }

      nextcloud: {
        label: "Nextcloud\n31200"
        icon: "./00-common/homepage/icons/nextcloud.png"
        style: {
          fill: "#ffffff"
