vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 101
  }
}

direction: down

users: {
  label: "Users"
  shape: person
  style: {
    fill: "#f8fafc"
    stroke: "#475569"
  }
}

public_host: {
  label: "PUBLIC_HOST"
  style: {
    fill: "#eef2ff"
    stroke: "#4f46e5"
    stroke-width: 2
  }
}

service_catalog: {
  label: "Inferlab Services"
  direction: down
  grid-columns: 1
  style: {
    fill: "#f8fafc"
    stroke: "#334155"
    stroke-width: 2
  }

  row_1: {
    label: "Infrastructure Layer"
    direction: right
    grid-columns: 3
    style: {
      fill: "#ffffff"
      stroke: "#cbd5e1"
    }

    00_common: {
      label: "00-common"
      grid-columns: 2
      style: {
        fill: "#f0fdfa"
        stroke: "#0f766e"
        stroke-width: 2
      }

      homepage: {
        label: "Homepage\n30000"
        icon: "./00-common/homepage/icons/homepage.png"
        style: {
          fill: "#ffffff"
          stroke: "#0f766e"
        }
      }

      keycloak: {
        label: "Keycloak\n30001 / 30002"
        icon: "./00-common/homepage/icons/keycloak.png"
        style: {
          fill: "#ffffff"
          stroke: "#0f766e"
        }
      }
    }

    01_infra: {
      label: "01-infra"
      grid-columns: 2
      style: {
        fill: "#eef2ff"
        stroke: "#4f46e5"
        stroke-width: 2
      }

      cloudflare: {
        label: "Cloudflare Tunnel"
        icon: "./00-common/homepage/icons/cloudflared.png"
        style: {
          fill: "#ffffff"
          stroke: "#4f46e5"
        }
      }

      couchdb: {
        label: "CouchDB\n30100"
        icon: "./00-common/homepage/icons/couchdb.png"
        style: {
          fill: "#ffffff"
          stroke: "#4f46e5"
        }
      }
    }

    30_developer: {
      label: "30-developer"
      grid-columns: 3
      style: {
        fill: "#f0f9ff"
        stroke: "#0284c7"
        stroke-width: 2
      }

      pypiserver: {
        label: "PyPI\n33100"
        icon: "./00-common/homepage/icons/pypi.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
        }
      }

      verdaccio: {
        label: "Verdaccio\n33200"
        icon: "./00-common/homepage/icons/verdaccio.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
        }
      }

      code_marketplace: {
        label: "Code Marketplace\n33300"
        icon: "./00-common/homepage/icons/visual-studio-code.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
        }
      }

      rpm_repo: {
        label: "RPM Repository\n33400"
        icon: "./00-common/homepage/icons/redhat-linux.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
        }
      }

      deb_repo: {
        label: "APT Repository\n33500"
        icon: "./00-common/homepage/icons/debian-linux.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
        }
      }
    }
  }

  row_2: {
    label: "Application Layer"
    direction: right
    grid-columns: 4
    style: {
      fill: "#ffffff"
      stroke: "#cbd5e1"
    }

    10_inference: {
      label: "10-inference"
      grid-columns: 3
      style: {
        fill: "#fefce8"
        stroke: "#a16207"
        stroke-width: 2
      }

      litellm: {
        label: "LiteLLM\n31000"
        icon: "./00-common/homepage/icons/litlellm.png"
        style: {
          fill: "#ffffff"
          stroke: "#a16207"
        }
      }

      ollama: {
        label: "Ollama"
        icon: "./00-common/homepage/icons/ollama.png"
        style: {
          fill: "#ffffff"
          stroke: "#a16207"
        }
      }

      tei: {
        label: "TEI\nEmbedding / Reranking"
        icon: "./00-common/homepage/icons/hugging-face.png"
        style: {
          fill: "#ffffff"
          stroke: "#a16207"
        }
      }

      openrouter: {
        label: "OpenRouter\n外部サービス"
        icon: "./00-common/homepage/icons/open-router.png"
        shape: cloud
        style: {
          fill: "#f8fafc"
          stroke: "#64748b"
          stroke-dash: 4
