{
    "$schema": "./openclaw.schema.json",
    "gateway": {
        "mode": "local",
        "bind": "lan",
        "port": 18789,
        "controlUi": {
            "allowInsecureAuth": true,
            "dangerouslyDisableDeviceAuth": true,
            "dangerouslyAllowHostHeaderOriginFallback": true,
            "allowedOrigins": [
                "http://localhost:18789",
                "http://127.0.0.1:18789",
                "http://localhost:31002",
                "http://127.0.0.1:31002"
            ]
        }
    },
    "models": {
        "mode": "replace",
        "providers": {
            "litellm": {
                "baseUrl": "http://litellm:4000/v1",
                "api": "openai-completions",
                "apiKey": {
                    "source": "env",
                    "provider": "default",
                    "id": "LITELLM_MASTER_KEY"
                },
                "headers": {
                    "x-litellm-disable-callbacks": "langfuse"
                },
                "models": [
                    {
                        "id": "google/gemma4:31b",
                        "name": "Gemma 4 31B via LiteLLM",
                        "contextWindow": 195000,
                        "maxTokens": 8192,
                        "reasoning": true
                    },
                    {
                        "id": "openai/gpt-oss:20b",
                        "name": "GPT OSS 20B via LiteLLM",
                        "contextWindow": 131000,
                        "maxTokens": 8192,
                        "reasoning": true
                    },
                    {
                        "id": "nvidia/nemotron-3-nano:30b",
                        "name": "Nemotron 3 Nano 30B via LiteLLM",
                        "contextWindow": 262000,
                        "maxTokens": 8192,
                        "reasoning": true
                    }
                ]
            }
        }
    },
    "agents": {
        "defaults": {
            "model": {
                "primary": "litellm/google/gemma4:31b",
                "fallbacks": [
                    "litellm/google/gemma4:31b",
                    "litellm/openai/gpt-oss:20b",
                    "litellm/nvidia/nemotron-3-nano:30b"
                ]
            },
            "models": {
                "litellm/google/gemma4:31b": {},
                "litellm/openai/gpt-oss:20b": {},
                "litellm/nvidia/nemotron-3-nano:30b": {}
            },
            "utilityModel": "litellm/google/gemma4:31b",
            "imageModel": {
                "primary": "litellm/google/gemma4:31b",
                "fallbacks": [
                    "litellm/google/gemma4:31b",
                    "litellm/openai/gpt-oss:20b",
                    "litellm/nvidia/nemotron-3-nano:30b"
                ]
            },
            "imageGenerationModel": {},
            "videoGenerationModel": {},
            "musicGenerationModel": {},
            "voiceModel": {
                "primary": "litellm/google/gemma4:31b",
                "fallbacks": [
                    "litellm/google/gemma4:31b",
                    "litellm/openai/gpt-oss:20b",
                    "litellm/nvidia/nemotron-3-nano:30b"
                ]
            },
            "pdfModel": {
                "primary": "litellm/google/gemma4:31b",
                "fallbacks": [
                    "litellm/google/gemma4:31b",
                    "litellm/openai/gpt-oss:20b",
                    "litellm/nvidia/nemotron-3-nano:30b"
                ]
            },
            "mediaGenerationAutoProviderFallback": false,
            "subagents": {
                "model": {
                    "primary": "litellm/google/gemma4:31b",
                    "fallbacks": [
                        "litellm/google/gemma4:31b",
                        "litellm/openai/gpt-oss:20b",
                        "litellm/nvidia/nemotron-3-nano:30b"
                    ]
                }
            }
        }
    },
    "tools": {
        "media": {
            "models": [
                {
                    "provider": "litellm",
                    "model": "google/gemma4:31b",
                    "capabilities": [
                        "image",
                        "video",
                        "audio"
                    ],
                    "type": "provider"
                },
                {
                    "provider": "litellm",
                    "model": "openai/gpt-oss:20b",
                    "capabilities": [
                        "image",
                        "video",
                        "audio"
                    ],
                    "type": "provider"
                },
                {
                    "provider": "litellm",
                    "model": "nvidia/nemotron-3-nano:30b",
                    "capabilities": [
                        "image",
                        "video",
                        "audio"
                    ],
                    "type": "provider"
                }
            ]
        },
        "exec": {
            "reviewer": {
                "model": {
                    "primary": "litellm/google/gemma4:31b",
                    "fallbacks": [
                        "litellm/google/gemma4:31b",
                        "litellm/openai/gpt-oss:20b",
                        "litellm/nvidia/nemotron-3-nano:30b"
                    ]
                }
            }
        }
    },
    "mcp": {
        "servers": {
            "searxng": {
                "enabled": true,
                "command": "npx",
                "args": [
                    "-y",
                    "mcp-searxng@1.14.0"
                ],
                "env": {
                    "SEARXNG_URL": "http://searxng:8080",
                    "SEARXNG_DEFAULT_LANGUAGE": "all",
                    "SEARXNG_MAX_RESULTS": "10",
                    "SEARXNG_MAX_RESULT_CHARS": "500",
                    "URL_READ_MAX_CHARS": "4000",
                    "NPM_CONFIG_CACHE": "/home/node/.openclaw/cache/npm"
                },
                "timeout": 30,
                "connect_timeout": 10,
                "keepalive_interval": 120
            },
            "docling": {
                "enabled": true,
                "command": "uvx",
                "args": [
                    "--from",
                    "docling-mcp==3.0.0",
                    "docling-mcp-server",
                    "--transport",
                    "stdio"
                ],
                "env": {
                    "DOCLING_MCP_CONVERSION_MODE": "remote",
                    "DOCLING_MCP_SERVICE_URL": "http://docling:5001",
                    "DOCLING_MCP_SERVICE_API_KEY": "sk-docling-serve-api-key",
                    "DOCLING_MCP_SERVICE_TIMEOUT": "300.0",
                    "DOCLING_MCP_SERVICE_MAX_RETRIES": "3",
                    "DOCLING_MCP_FALLBACK_TO_LOCAL": "false",
                    "UV_CACHE_DIR": "/home/node/.openclaw/cache/uv"
                },
                "timeout": 300,
                "connect_timeout": 30,
                "keepalive_interval": 120
            }
        }
    },
    "messages": {
        "tts": {
            "enabled": true,
            "auto": "off",
            "mode": "final",
            "provider": "openai",
            "summaryModel": "litellm/google/gemma4:31b",
            "providers": {
                "openai": {
                    "baseUrl": "http://kokoro:8880/v1",
                    "model": "kokoro",
                    "voice": "jf_alpha",
                    "speed": 1.0,
                    "apiKey": "not-needed"
                }
            }
        }
    },
    "plugins": {
        "bundledDiscovery": "compat",
        "allow": [
            "browser",
            "canvas",
            "device-pair",
            "discord",
            "file-transfer",
            "langfuse-bridge",
            "litellm",
            "memory-core",
            "phone-control"
        ],
        "entries": {
            "discord": {
                "enabled": true
            },
            "langfuse-bridge": {
                "enabled": true
            }
        }
    },
    "channels": {
        "discord": {
            "enabled": true,
            "token": {
                "source": "env",
                "provider": "default",
                "id": "DISCORD_BOT_TOKEN"
            },
            "dmPolicy": "disabled",
            "dm": {
                "enabled": false
            },
            "groupPolicy": "allowlist",
            "guilds": {
                "${DISCORD_GUILD_ID}": {
                    "requireMention": true,
                    "ignoreOtherMentions": true,
                    "channels": {
                        "${DISCORD_CHANNEL_ID}": {
                            "enabled": true
                        }
                    }
                }
            }
        }
    }
}
