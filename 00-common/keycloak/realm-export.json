{
    "realm": "${STACK_NAME:-inferlab}",
    "enabled": true,
    "displayName": "${STACK_NAME:-inferlab}",
    "registrationAllowed": false,
    "resetPasswordAllowed": true,
    "loginWithEmailAllowed": true,
    "duplicateEmailsAllowed": false,
    "groups": [
        {
            "name": "admins",
            "path": "/admins"
        },
        {
            "name": "guests",
            "path": "/guests"
        },
        {
            "name": "users",
            "path": "/users"
        }
    ],
    "users": [
        {
            "username": "admin",
            "enabled": true,
            "firstName": "admin",
            "lastName": "admin",
            "email": "admin@admin.com",
            "emailVerified": true,
            "groups": [
                "/admins",
                "/users"
            ],
            "credentials": [
                {
                    "type": "password",
                    "value": "${KEYCLOAK_REALM_ADMIN_PASSWORD:-admin}",
                    "temporary": false
                }
            ]
        }
    ],
    "clients": [
        {
            "clientId": "open-webui",
            "name": "Open WebUI",
            "enabled": true,
            "protocol": "openid-connect",
            "publicClient": false,
            "clientAuthenticatorType": "client-secret",
            "secret": "${OPEN_WEBUI_OIDC_CLIENT_SECRET:-open-webui-oauth-client-secret-key}",
            "standardFlowEnabled": true,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "rootUrl": "http://${PUBLIC_HOST}:31100/",
            "redirectUris": [
                "http://localhost:31100/oauth/oidc/callback",
                "http://${PUBLIC_HOST}:31100/oauth/oidc/callback"
            ],
            "webOrigins": [
                "http://localhost:31100",
                "http://${PUBLIC_HOST}:31100"
            ],
            "protocolMappers": [
                {
                    "name": "groups",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-group-membership-mapper",
                    "consentRequired": false,
                    "config": {
                        "claim.name": "groups",
                        "full.path": "false",
                        "introspection.token.claim": "true",
                        "multivalued": "true",
                        "id.token.claim": "true",
                        "access.token.claim": "true",
                        "userinfo.token.claim": "true"
                    }
                }
            ]
        },
        {
            "clientId": "langfuse",
            "name": "Langfuse",
            "enabled": true,
            "protocol": "openid-connect",
