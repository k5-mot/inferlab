            "standardFlowEnabled": true,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "redirectUris": [
                "http://localhost:35100/api/auth/callback/keycloak",
                "http://localhost:35100/*",
                "http://${PUBLIC_HOST}:35100/api/auth/callback/keycloak",
                "http://${PUBLIC_HOST}:35100/*"
            ],
            "webOrigins": [
                "http://localhost:35100",
                "http://${PUBLIC_HOST}:35100"
            ],
            "protocolMappers": [
                {
                    "name": "groups",
                    "protocol": "openid-connect",
