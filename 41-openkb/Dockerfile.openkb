FROM python:3.12.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OPENKB_KB_ROOT=/data/kbs

RUN pip install --no-cache-dir "openkb[web]==0.5.0rc1" \
    && useradd --create-home --uid 1000 openkb \
    && mkdir -p /data/kbs \
    && chown -R openkb:openkb /data/kbs

USER openkb

EXPOSE 7566

CMD ["openkb-web", "--host", "0.0.0.0", "--port", "7566"]
