{
  "$schema": "https://pi.dev/schemas/models.schema.json",
  "providers": {
    "inferlab": {
      "baseUrl": "http://litellm:4000/v1",
      "api": "openai-completions",
      "apiKey": "!cat /run/secrets/pi-litellm-api-key",
      "headers": {
        "langfuse_trace_name": "Pi",
        "langfuse_generation_name": "pi",
        "langfuse_tags": "[\"pi\", \"open-terminal\"]"
      },
      "models": [
        {
          "id": "openai/gpt-oss:20b",
          "name": "GPT OSS 20B (InferLab)",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 131072,
          "maxTokens": 16384
        },
        {
          "id": "google/gemma4:31b",
          "name": "Gemma 4 31B (InferLab)",
          "input": ["text", "image"],
          "contextWindow": 131072,
          "maxTokens": 8192
        },
        {
          "id": "google/gemma4:12b",
          "name": "Gemma 4 12B (InferLab)",
          "input": ["text", "image"],
          "contextWindow": 32768,
          "maxTokens": 8192
        }
      ]
    }
  }
}
