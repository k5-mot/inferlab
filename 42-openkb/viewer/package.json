{
  "name": "inferlab-openkb-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && node --input-type=module -e \"import {build} from 'esbuild'; await build({entryPoints:['src/graph.ts'],bundle:true,minify:true,platform:'browser',target:'es2022',outfile:'static/graph/graph.js'})\"",
    "test": "pnpm build && node --test tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cytoscape": "3.33.1",
    "gray-matter": "4.0.3",
    "js-yaml": "4.1.0",
    "lucide": "0.544.0",
    "mint": "4.2.821",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cytoscape": "3.21.9",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.1",
    "esbuild": "0.25.9",
    "typescript": "5.9.2"
  }
}
