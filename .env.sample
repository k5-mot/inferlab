### 41-knowledge
### ------------------------------
# [OPTIONAL] llm-wiki release version。
LLM_WIKI_VERSION=v0.5.5
# [OPTIONAL] llm-wiki image名。
LLM_WIKI_IMAGE=inferlab/llm-wiki:v0.5.5
# [OPTIONAL] llm-wiki HTTP MCP host公開port。
LLM_WIKI_HTTP_HOST_PORT=34100
# [OPTIONAL] llm-wiki space名。
LLM_WIKI_SPACE_NAME=inferlab
# [OPTIONAL] llm-wiki Git author名。
LLM_WIKI_GIT_AUTHOR_NAME=InferLab LLM Wiki
# [OPTIONAL] llm-wiki Git author email。
LLM_WIKI_GIT_AUTHOR_EMAIL=llm-wiki@inferlab.local
# [OPTIONAL] llm-wiki Git committer名。
LLM_WIKI_GIT_COMMITTER_NAME=InferLab LLM Wiki
# [OPTIONAL] llm-wiki Git committer email。
LLM_WIKI_GIT_COMMITTER_EMAIL=llm-wiki@inferlab.local
# [OPTIONAL] LLMwiki sync-worker image名。
LLMWIKI_SYNC_WORKER_IMAGE=inferlab/llmwiki-sync-worker:latest
# [OPTIONAL] LLMwiki sync-workerの読み込み間隔秒。
LLMWIKI_SYNC_INTERVAL_SECONDS=3600
# [OPTIONAL] LLMwiki sync-workerのHTTP timeout秒。
LLMWIKI_SYNC_HTTP_TIMEOUT_SECONDS=30
# [OPTIONAL] LLMwiki sync-worker WebUIを有効化するか。
LLMWIKI_SYNC_WEB_ENABLED=true
# [OPTIONAL] LLMwiki sync-worker WebUIのhost bind。
LLMWIKI_SYNC_WEB_HOST_BIND=127.0.0.1
# [OPTIONAL] LLMwiki sync-worker WebUIのhomepage表示host。
LLMWIKI_SYNC_WEB_PUBLIC_HOST=127.0.0.1
# [OPTIONAL] LLMwiki sync-worker WebUIのhost公開port。
LLMWIKI_SYNC_WEB_HOST_PORT=34101
# [OPTIONAL] CouchDB sourceを有効化するか。
LLMWIKI_SYNC_COUCHDB_ENABLED=true
# [OPTIONAL] CouchDB sourceのdatabase別最大処理件数。
LLMWIKI_SYNC_COUCHDB_MAX_DOCS_PER_DATABASE=50
# [OPTIONAL] Nextcloud sourceを有効化するか。
LLMWIKI_SYNC_NEXTCLOUD_ENABLED=false
# [OPTIONAL] Nextcloud WebDAV同期用user。
NEXTCLOUD_LLMWIKI_USER=
# [OPTIONAL] Nextcloud WebDAV同期用passwordまたはapp password。
NEXTCLOUD_LLMWIKI_PASSWORD=
# [OPTIONAL] Nextcloud WebDAV同期root path。
NEXTCLOUD_LLMWIKI_ROOT_PATH=/
# [OPTIONAL] Nextcloud WebDAV PROPFIND depth。
NEXTCLOUD_LLMWIKI_DEPTH=1
# [OPTIONAL] Nextcloud WebDAV同期最大件数。
NEXTCLOUD_LLMWIKI_MAX_ITEMS=50
# [OPTIONAL] BookStack sourceを有効化するか。
LLMWIKI_SYNC_BOOKSTACK_ENABLED=false
# [OPTIONAL] BookStack API token ID。
BOOKSTACK_LLMWIKI_TOKEN_ID=
# [OPTIONAL] BookStack API token secret。
BOOKSTACK_LLMWIKI_TOKEN_SECRET=
# [OPTIONAL] BookStack endpoint別最大件数。
BOOKSTACK_LLMWIKI_MAX_ITEMS=50
# [OPTIONAL] Zulip sourceを有効化するか。
LLMWIKI_SYNC_ZULIP_ENABLED=false
# [OPTIONAL] Zulip内部URL。
ZULIP_URL=https://zulip
# [OPTIONAL] Zulip botまたはuser email。
ZULIP_LLMWIKI_EMAIL=
# [OPTIONAL] Zulip API key。
ZULIP_LLMWIKI_API_KEY=
# [OPTIONAL] Zulip TLS検証を有効化するか。
ZULIP_LLMWIKI_VERIFY_TLS=false
# [OPTIONAL] Zulip stream同期最大件数。
ZULIP_LLMWIKI_MAX_STREAMS=50
# [OPTIONAL] Zulip message同期最大件数。
ZULIP_LLMWIKI_MAX_MESSAGES=50
# [OPTIONAL] Kaneo sourceを有効化するか。
LLMWIKI_SYNC_KANEO_ENABLED=false
# [OPTIONAL] Kaneo API token。
KANEO_LLMWIKI_API_TOKEN=
# [OPTIONAL] Kaneo workspace ID。
KANEO_LLMWIKI_WORKSPACE_ID=
# [OPTIONAL] Kaneo project同期最大件数。
KANEO_LLMWIKI_MAX_PROJECTS=50
# [OPTIONAL] GitLab sourceを有効化するか。
LLMWIKI_SYNC_GITLAB_ENABLED=false
# [OPTIONAL] GitLab Personal Access Token。
GITLAB_LLMWIKI_TOKEN=
# [OPTIONAL] GitLab project同期最大件数。
GITLAB_LLMWIKI_MAX_PROJECTS=50

