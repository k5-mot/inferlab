# 配備先
STACK_NAME=inferlab
PUBLIC_HOST=192.168.1.100

# 共通
KEYCLOAK_HOST_PORT=30000
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<change-me>
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak_user
KEYCLOAK_POSTGRES_PASSWORD=<change-me>
HOMEPAGE_HOST_PORT=30002
CLOUDFLARE_TUNNEL_TOKEN=
COUCHDB_USER=obsidian
COUCHDB_PASSWORD=<change-me>

# 推論
LITELLM_HOST_PORT=40000
LITELLM_MASTER_KEY=sk-litellm-master-key
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST_PORT=11434
OLLAMA_API_KEY=sk-ollama-api-key

# Web UI
OPEN_WEBUI_HOST_PORT=31001
OPEN_WEBUI_PUBLIC_URL=http://${PUBLIC_HOST}:31001
OPEN_WEBUI_SECRET_KEY=
OPEN_WEBUI_API_KEY="<Open WebUI account API key>"
DOCLING_HOST_PORT=50000
VOICEVOX_ENGINE_HOST_PORT=50021
VOICEVOX_OPENAI_TTS_HOST_PORT=50022

# ストレージ
NEXTCLOUD_HOST_PORT=31012
NEXTCLOUD_PUBLIC_URL=http://${PUBLIC_HOST}:31012
NEXTCLOUD_TRUSTED_DOMAINS="localhost 127.0.0.1 ${PUBLIC_HOST} nextcloud"
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=<change-me>
NEXTCLOUD_MYSQL_DATABASE=nextcloud
NEXTCLOUD_MYSQL_USER=nextcloud
NEXTCLOUD_MYSQL_ROOT_PASSWORD=<change-me>
NEXTCLOUD_MYSQL_PASSWORD=<change-me>
NEXTCLOUD_PHP_MEMORY_LIMIT=1024M
NEXTCLOUD_PHP_UPLOAD_LIMIT=2G
NEXTCLOUD_OIDC_CLIENT_ID=nextcloud
NEXTCLOUD_OIDC_CLIENT_SECRET=nextcloud-oauth-client-secret-key
NEXTCLOUD_OIDC_DISCOVERY_URL=http://${PUBLIC_HOST}:30000/realms/inferlab/.well-known/openid-configuration
NEXTCLOUD_OIDC_SCOPE="openid profile email"
NEXTCLOUD_OIDC_ALLOW_INSECURE_HTTP=true
NEXTCLOUD_ALLOW_LOCAL_REMOTE_SERVERS=true

# OIKB
OIKB_HOST_PORT=31013
OIKB_API_KEY=<change-me>
OIKB_LOG_FORMAT=json
OIKB_NEXTCLOUD_URL=http://nextcloud
OIKB_NEXTCLOUD_USER=admin
OIKB_NEXTCLOUD_PASSWORD=<change-me>
OIKB_NEXTCLOUD_SOURCE=/nextcloud/data/admin/files/Documents
OIKB_NEXTCLOUD_INTERVAL=1h
NEXTCLOUD_OPENWEBUI_KB_ID="<Open WebUI Knowledge Base UUID>"
OPEN_WEBUI_BASE_URL=http://open-webui:8080

# AI エージェント
HERMES_AGENT_HOST_PORT=31006
HERMES_AGENT_PORT=8642
HERMES_AGENT_API_SERVER_KEY=hermes-agent-secret-key
HERMES_AGENT_GATEWAY_ALLOW_ALL_USERS=true

# 観測
LANGFUSE_HOST_PORT=30001
NEXTAUTH_URL=http://${PUBLIC_HOST}:30001
NEXTAUTH_SECRET=<change-me>
SALT=<change-me>
ENCRYPTION_KEY="<openssl rand -hex 32>"
TELEMETRY_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-langfuse-project-public-key
LANGFUSE_SECRET_KEY=sk-lf-langfuse-project-secret-key
LANGFUSE_OTEL_HOST=http://langfuse-web:3000
LANGFUSE_INIT_ORG_ID=org0
LANGFUSE_INIT_ORG_NAME=org0
LANGFUSE_INIT_PROJECT_ID=prg0
LANGFUSE_INIT_PROJECT_NAME=prg0
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-langfuse-project-public-key
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-langfuse-project-secret-key
LANGFUSE_INIT_USER_EMAIL=admin@langfuse.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=<change-me>
CLICKHOUSE_DB=langfuse_chdb
CLICKHOUSE_USER=clickhouse_user
CLICKHOUSE_PASSWORD=<change-me>
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=<change-me>
REDIS_AUTH=<change-me>
POSTGRES_DB=langfuse_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=<change-me>
