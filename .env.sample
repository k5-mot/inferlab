### 12-registry
### ------------------------------
# [OPTIONAL] Docker Registry image tag。
DOCKER_REGISTRY_IMAGE_TAG=3.1.1
# [OPTIONAL] Docker Registry host公開port。
DOCKER_REGISTRY_HTTP_HOST_PORT=31205
# [OPTIONAL] pypiserver image tag。
PYPISERVER_IMAGE_TAG=v2.4.1
# [OPTIONAL] pypiserver host公開port。
PYPISERVER_HTTP_HOST_PORT=31200
# [OPTIONAL] Verdaccio image tag。
VERDACCIO_IMAGE_TAG=6.9.0
# [OPTIONAL] Verdaccio host公開port。
VERDACCIO_HTTP_HOST_PORT=31201
# [OPTIONAL] code-marketplace image tag。
CODE_MARKETPLACE_IMAGE_TAG=v2.4.2
# [OPTIONAL] code-marketplace host公開port。
CODE_MARKETPLACE_HTTP_HOST_PORT=31202
# [OPTIONAL] code-marketplace import間隔。
CODE_MARKETPLACE_IMPORT_INTERVAL_SECONDS=300
# [OPTIONAL] npm importer用Node image tag。
NODE_IMAGE_TAG=22-alpine
# [OPTIONAL] npm importを有効化するか。
NPM_IMPORT_ENABLED=true
# [OPTIONAL] npm import間隔。
NPM_IMPORT_INTERVAL_SECONDS=30
# [REQUIRED] npm publish token。
NPM_PUBLISH_TOKEN=local-publish-token
# [OPTIONAL] repository sync間隔。
REPOSITORY_SYNC_INTERVAL_SECONDS=30
# [OPTIONAL] RPM publisher image。
RPM_PUBLISHER_IMAGE=docker.io/openitcockpit/createrepo_c:bullseye-0.17.0
