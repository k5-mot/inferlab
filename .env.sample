### ------------------------------
### 33-zulip
### ------------------------------
# [OPTIONAL] Zulip external host。
ZULIP_EXTERNAL_HOST=localhost:33300
# [OPTIONAL] Zulip admin email。
ZULIP_ADMIN_EMAIL=admin@example.com
# [OPTIONAL] Zulip email host。
ZULIP_EMAIL_HOST=
# [OPTIONAL] Zulip email host user。
ZULIP_EMAIL_HOST_USER=noreply@example.com
# [OPTIONAL] Zulip email port。
ZULIP_EMAIL_PORT=587
# [OPTIONAL] Zulip email SSL。
ZULIP_EMAIL_USE_SSL=False
# [OPTIONAL] Zulip email TLS。
ZULIP_EMAIL_USE_TLS=True
# [OPTIONAL] Zulip open realm creation。
ZULIP_OPEN_REALM_CREATION=True
# [OPTIONAL] Zulip fake email domain。
ZULIP_FAKE_EMAIL_DOMAIN=zulip.local
# [OPTIONAL] Zulip default color scheme。auto、automatic、dark、light、1、2、3を指定できる。
ZULIP_DEFAULT_COLOR_SCHEME=light
# [OPTIONAL] Zulip default color schemeを既存通常userへ反映する。
ZULIP_APPLY_DEFAULT_COLOR_SCHEME_TO_EXISTING_USERS=True
# [OPTIONAL] Zulip layoutをwindow幅へ追従させる。
ZULIP_FLUID_LAYOUT_WIDTH=True
# [OPTIONAL] Zulip fluid layoutを既存通常userへ反映する。
ZULIP_APPLY_FLUID_LAYOUT_WIDTH_TO_EXISTING_USERS=True
# [OPTIONAL] Zulip auto create realm ID。
ZULIP_AUTO_CREATE_REALM_ID=
# [OPTIONAL] Zulip auto create realm name。
ZULIP_AUTO_CREATE_REALM_NAME=InferLab
# [OPTIONAL] Zulip auto create admin email。
ZULIP_AUTO_CREATE_ADMIN_EMAIL=admin@example.com
# [OPTIONAL] Zulip auto create admin name。
ZULIP_AUTO_CREATE_ADMIN_NAME="InferLab Admin"
# [REQUIRED] Zulip auto create admin password。
ZULIP_AUTO_CREATE_ADMIN_PASSWORD=
# [OPTIONAL] Zulip authentication backends。
ZULIP_AUTH_BACKENDS=EmailAuthBackend,GenericOpenIdConnectBackend
# [OPTIONAL] Zulip OIDC連携を有効化する。
ZULIP_OIDC_ENABLED=True
# [OPTIONAL] Zulip OIDC provider key。
ZULIP_OIDC_IDP_KEY=keycloak
# [OPTIONAL] Zulip OIDC login button表示名。
ZULIP_OIDC_DISPLAY_NAME=Keycloak
# [OPTIONAL] Zulip OIDC login button icon。空の場合はiconなし。
ZULIP_OIDC_DISPLAY_ICON=
# [OPTIONAL] Zulip OIDC issuer URL。
ZULIP_OIDC_URL=https://localhost:30002/realms/inferlab
# [OPTIONAL] Zulip OIDC client ID。
ZULIP_OIDC_CLIENT_ID=zulip
# [REQUIRED] Zulip OIDC client secret。
ZULIP_OIDC_CLIENT_SECRET=sk-zulip-oidc-client-secret-key
# [OPTIONAL] Zulip OIDC login時の自動signup。
ZULIP_OIDC_AUTO_SIGNUP=True
# [OPTIONAL] Zulip OIDC full name検証済み扱い。
ZULIP_OIDC_FULL_NAME_VALIDATED=True
# [REQUIRED] Zulip email password。
ZULIP_EMAIL_PASSWORD=123456789
# [REQUIRED] Zulip RabbitMQ password。
ZULIP_RABBITMQ_PASSWORD=zulip_password
# [REQUIRED] Zulip Postgres password。
ZULIP_POSTGRES_PASSWORD=zulip_password
# [REQUIRED] Zulip Memcached password。
ZULIP_MEMCACHED_PASSWORD=zulip_password
# [REQUIRED] Zulip Redis password。
ZULIP_REDIS_PASSWORD=zulip_password
# [REQUIRED] Zulip secret key。
ZULIP_SECRET_KEY=sk-zulip-secret-key
# [OPTIONAL] Zulip container memory上限。
ZULIP_MEM_LIMIT=4g
# [OPTIONAL] Zulip container memory+swap上限。
ZULIP_MEMSWAP_LIMIT=4g
# [OPTIONAL] Zulip Django uWSGI worker数。
ZULIP_UWSGI_PROCESSES=4
# [OPTIONAL] Zulip queue workerをmultiprocessで動かすか。
ZULIP_QUEUE_WORKERS_MULTIPROCESS=false
# [OPTIONAL] Zulip HTTPS host公開port。
ZULIP_HTTPS_HOST_PORT=33300
# [OPTIONAL] Zulip HTTP host公開port。
ZULIP_HTTP_HOST_PORT=33302
# [OPTIONAL] Zulip SMTP host公開port。
ZULIP_SMTP_HOST_PORT=33325

