### ------------------------------
### [REQUIRED] General
### ------------------------------
STACK_NAME=inferlab
PUBLIC_HOST=192.168.1.100
### Homepageのアイコンをローカル汎用SVGに切り替える場合のみtrueにする.
AIRGAP="false"

### ------------------------------
### [REQUIRED] External LLM Providers
### ------------------------------
### Ollama API Key
OLLAMA_API_KEY="<ollama-api-key>"
### OpenRouter API Key
OPENROUTER_API_KEY="<openrouter-api-key>"
### Google AI Studio API Key
GEMINI_API_KEY="<google-ai-studio-api-key>"

### ------------------------------
### [REQUIRED] 00-common stacks
### ------------------------------

### ------------------------------
### [REQUIRED] 01-infra stacks
### ------------------------------
### Cloudflare tunnel
CLOUDFLARE_DOMAIN="example.com"
CLOUDFLARE_TUNNEL_TOKEN="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

### CouchDB
COUCHDB_USER="couchdb_user"
COUCHDB_PASSWORD="couchdb_password"

### ------------------------------
### [REQUIRED] 10-inference stacks
### ------------------------------
LITELLM_MASTER_KEY="sk-litellm-master-key"
OPEN_WEBUI_API_KEY="<Open WebUI account API key>"
DISCORD_BOT_TOKEN="<discord-bot-token>"
DISCORD_ALLOWED_USERS="000000000000000000"
DISCORD_ALLOWED_CHANNELS="0000000000000000000"
DISCORD_HOME_CHANNEL="0000000000000000000"
DISCORD_HOME_CHANNEL_NAME="general"

### ------------------------------
### [REQUIRED] 11-webui stacks
### ------------------------------

### ------------------------------
### [REQUIRED] 12-storage stacks
### ------------------------------
NEXTCLOUD_OIDC_CLIENT_SECRET="sk-nextcloud-oidc-client-secret-key"
NEXTCLOUD_OPENWEBUI_KB_ID="<replace-with-openwebui-kb-id>"

### ------------------------------
### [REQUIRED] 23-team-git stacks
### ------------------------------
GITEA_HTTP_HOST_PORT=32300
GITEA_SSH_HOST_PORT=32322
GITEA_USER_UID=1000
GITEA_USER_GID=1000
GITEA_DB_NAME="gitea"
GITEA_DB_USER="gitea"
GITEA_DB_PASSWORD="gitea_password"
GITEA_SECRET_KEY="sk-gitea-secret-key-change-me"
GITEA_INTERNAL_TOKEN="sk-gitea-internal-token-change-me"
GITEA_DISABLE_REGISTRATION=true
GITEA_REQUIRE_SIGNIN_VIEW=false
GITEA_METRICS_ENABLED=true
GITEA_ADMIN_USER="admin"
GITEA_ADMIN_PASSWORD="admin"
GITEA_ADMIN_EMAIL="admin@example.com"

### ------------------------------
### [REQUIRED] 30-developer stacks
### ------------------------------
PULP_HTTP_HOST_PORT=33000
PULP_SECRET_KEY="sk-pulp-secret-key-change-me"
PULP_DEFAULT_ADMIN_PASSWORD="pulp_admin_password"
PULP_POSTGRES_PASSWORD="pulp_password"
PULP_REDIS_PASSWORD="pulp_redis_password"
PULP_OIDC_CLIENT_ID="pulp"
PULP_OIDC_CLIENT_SECRET="sk-pulp-oidc-client-secret-key"
PULP_KEYCLOAK_REALM="inferlab"
PULP_KEYCLOAK_PUBLIC_KEY=""
PULP_KEYCLOAK_BASE_URL="http://192.168.1.100:30001"
PULP_BASE_TAG="stable"
PULP_IMAGE_TAG="custom"
PULP_WORKER_REPLICAS=2

### ------------------------------
### [REQUIRED] 50-o11y stacks
### ------------------------------
GRAFANA_HTTP_HOST_PORT=35000
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"
PROMETHEUS_HTTP_HOST_PORT=35001
PROMETHEUS_RETENTION_TIME="30d"

### ------------------------------
### [REQUIRED] 51-llmops stacks
### ------------------------------
LANGFUSE_OIDC_CLIENT_SECRET="sk-langfuse-oidc-client-secret-key"
LANGFUSE_PUBLIC_KEY="pk-lf-langfuse-project-public-key"
LANGFUSE_SECRET_KEY="sk-lf-langfuse-project-secret-key"
