### ------------------------------
### General
### ------------------------------
# [REQUIRED] 外部からアクセスするhost名またはIP。
PUBLIC_HOST=localhost
# [OPTIONAL] compose project名。省略時はinferlab。
STACK_NAME=inferlab

### ------------------------------
### 00-common
### ------------------------------
# [OPTIONAL] whoamiのhost公開port。
WHOAMI_HTTP_HOST_PORT=30003
# [OPTIONAL] whoami image tag。
WHOAMI_IMAGE_TAG=v1.11

### ------------------------------
### 01-keycloak
### ------------------------------
# [REQUIRED] Keycloak realm adminの初期password。
KEYCLOAK_REALM_ADMIN_PASSWORD=admin
# [OPTIONAL] Open WebUI host公開port。
OPEN_WEBUI_HTTP_HOST_PORT=32000
# [OPTIONAL] Dify host公開port。
DIFY_HTTP_HOST_PORT=32100
# [OPTIONAL] Nextcloud host公開port。
NEXTCLOUD_HTTP_HOST_PORT=33000
# [OPTIONAL] Kaneo host公開port。
KANEO_HTTP_HOST_PORT=33200
# [OPTIONAL] Leantime host公開port。
LEANTIME_HTTP_HOST_PORT=33900
# [OPTIONAL] Langfuse host公開port。
LANGFUSE_HTTP_HOST_PORT=35100
# [REQUIRED] Open WebUI OIDC client secret。
OPEN_WEBUI_OIDC_CLIENT_SECRET=open-webui-oauth-client-secret-key
# [REQUIRED] Dify OIDC client secret。
DIFY_OIDC_CLIENT_SECRET=sk-dify-oidc-client-secret-key
# [REQUIRED] Nextcloud OIDC client secret。
NEXTCLOUD_OIDC_CLIENT_SECRET=sk-nextcloud-oidc-client-secret-key
# [REQUIRED] Langfuse OIDC client secret。
LANGFUSE_OIDC_CLIENT_SECRET=sk-langfuse-oidc-client-secret-key
# [REQUIRED] Leantime OIDC client secret。
LEANTIME_OIDC_CLIENT_SECRET=sk-leantime-oidc-client-secret-key
# [REQUIRED] BookStack OIDC client secret。
BOOKSTACK_OIDC_CLIENT_SECRET=sk-bookstack-oidc-client-secret-key
# [REQUIRED] Kaneo OIDC client secret。
KANEO_OIDC_CLIENT_SECRET=sk-kaneo-oidc-client-secret-key
# [REQUIRED] Zulip OIDC client secret。
ZULIP_OIDC_CLIENT_SECRET=sk-zulip-oidc-client-secret-key
# [REQUIRED] GitLab OIDC client secret。
GITLAB_OIDC_CLIENT_SECRET=sk-gitlab-oidc-client-secret-key
# [REQUIRED] Grafana OIDC client secret。
GRAFANA_OIDC_CLIENT_SECRET=sk-grafana-oidc-client-secret-key
# [OPTIONAL] Keycloak HTTPS host公開port。
KEYCLOAK_HTTPS_HOST_PORT=30002
# [OPTIONAL] Keycloak HTTP header上限。
KEYCLOAK_HTTP_MAX_HEADER_SIZE=512K
# [OPTIONAL] Keycloak HTTP/2 header list上限。
KEYCLOAK_HTTP_MAX_HEADER_LIST_SIZE=524288

### ------------------------------
### 02-pubnet
### ------------------------------
# [REQUIRED] pubnet profileでCloudflare Tunnelを使う場合に設定する。
CLOUDFLARE_TUNNEL_TOKEN=

### ------------------------------
### 10-inference: LiteLLM / Ollama / TEI
### ------------------------------
# [REQUIRED] LiteLLM master key。
LITELLM_MASTER_KEY=sk-litellm-master-key
# [REQUIRED] OpenRouter API key。
OPENROUTER_API_KEY=
# [REQUIRED] Google AI Studio API key。
GEMINI_API_KEY=
# [REQUIRED] Groq API Key
GROQ_API_KEY=
# [REQUIRED] Cloudflare Workers AI API Key
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
# [OPTIONAL] Ollama API base URL。
OLLAMA_BASE_URL=http://ollama:11434
# [OPTIONAL] Docling container memory limit。
DOCLING_MEM_LIMIT=8g
# [OPTIONAL] Docling container memswap limit。
DOCLING_MEMSWAP_LIMIT=9g

### ------------------------------
### 10-inference: Hermes-Agent
### ------------------------------
# [OPTIONAL] Hermes-Agent custom image。
HERMES_AGENT_IMAGE=inferlab/hermes-agent:v2026.7.30-uid
# [OPTIONAL] Hermes-Agent base image。
HERMES_AGENT_BASE_IMAGE=docker.io/nousresearch/hermes-agent:v2026.7.30
# [REQUIRED] Hermes-Agent API server key。
HERMES_AGENT_API_SERVER_KEY=hermes-agent-secret-key
# [OPTIONAL] Hermes-Agent API server port。
HERMES_AGENT_PORT=8642
# [OPTIONAL] Hermes-Agent gatewayで全userを許可するか。
HERMES_AGENT_GATEWAY_ALLOW_ALL_USERS=true
# [OPTIONAL] Hermes-Agent gatewayで許可するuser一覧。
HERMES_AGENT_GATEWAY_ALLOWED_USERS=
# [OPTIONAL] Hermes-Agent report timezone。
REPORT_TIMEZONE=Asia/Tokyo
# [OPTIONAL] Hermes-Agent dashboard basic auth user。
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# [REQUIRED] Hermes-Agent dashboard basic auth password。
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=pw-hermes-agent-dashboard-password
# [REQUIRED] Hermes-Agent dashboard basic auth secret。
HERMES_DASHBOARD_BASIC_AUTH_SECRET=sk-hermes-agent-dashboard-secret
# [OPTIONAL] Hermes-Agent volume owner UID。
HERMES_UID=1000
# [OPTIONAL] Hermes-Agent volume owner GID。
HERMES_GID=1000

### ------------------------------
### 10-inference: OpenClaw
### ------------------------------
# [OPTIONAL] OpenClaw custom image。
OPENCLAW_IMAGE=inferlab/openclaw:2026.7.1-browser
# [OPTIONAL] OpenClaw custom imageのbase image。
OPENCLAW_BASE_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1-browser
# [OPTIONAL] OpenClaw gateway bind mode。
OPENCLAW_GATEWAY_BIND=lan
# [REQUIRED] OpenClaw gateway token。
OPENCLAW_GATEWAY_TOKEN=sk-openclaw-gateway-token
# [OPTIONAL] OpenClaw private websocketを許可する場合に設定。
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=
# [OPTIONAL] OpenClaw bonjour無効化flag。
OPENCLAW_DISABLE_BONJOUR=
# [OPTIONAL] OpenClaw timezone。
OPENCLAW_TZ=Asia/Tokyo

### ------------------------------
### 10-inference: Open WebUI bridge / Discord
### ------------------------------
# [OPTIONAL] Open WebUI API base URL。
OPEN_WEBUI_BASE_URL=http://open-webui:8080
# [REQUIRED] Open WebUI account API key。
OPEN_WEBUI_API_KEY=
# [OPTIONAL] Open WebUI public URL。
OPEN_WEBUI_PUBLIC_URL=http://localhost:32000
# [OPTIONAL] Open WebUI default channel。
OPEN_WEBUI_DEFAULT_CHANNEL=general
# [OPTIONAL] Open WebUI channels list path。
OPEN_WEBUI_CHANNELS_LIST_PATH=/api/v1/channels/
# [OPTIONAL] Open WebUI channel post path template。
OPEN_WEBUI_CHANNELS_POST_PATH_TEMPLATE=/api/v1/channels/{channel_id}/messages
# [OPTIONAL] Open WebUI chats DB path。
OPEN_WEBUI_CHATS_ALL_DB_PATH=/api/v1/chats/all/db
# [OPTIONAL] Open WebUI message最大文字数。
OPEN_WEBUI_MAX_MESSAGE_CHARS=20000
# [OPTIONAL] Discord連携を使う場合に設定。
DISCORD_BOT_TOKEN=
# [OPTIONAL] Discord許可user ID一覧。
DISCORD_ALLOWED_USERS=
# [OPTIONAL] Discord許可channel ID一覧。
DISCORD_ALLOWED_CHANNELS=
# [OPTIONAL] Discord home channel ID。
DISCORD_HOME_CHANNEL=
# [OPTIONAL] Discord home channel名。
DISCORD_HOME_CHANNEL_NAME=
# [OPTIONAL] Voice tools用OpenAI key。通常は不要。
VOICE_TOOLS_OPENAI_KEY=not-needed
# [REQUIRED] OpenClaw Discord bot token。
OPENCLAW_DISCORD_BOT_TOKEN=
# [REQUIRED] OpenClaw Discord guild ID。
OPENCLAW_DISCORD_GUILD_ID=
# [REQUIRED] OpenClaw Discord channel ID。
OPENCLAW_DISCORD_CHANNEL_ID=


### ------------------------------
### 10-inference / 51-langfuse: Langfuse tracing
### ------------------------------
# [REQUIRED] Langfuse project public key。
LANGFUSE_PUBLIC_KEY=pk-lf-langfuse-project-public-key
# [REQUIRED] Langfuse project secret key。
LANGFUSE_SECRET_KEY=sk-lf-langfuse-project-secret-key
# [OPTIONAL] Langfuse OTEL host。
LANGFUSE_OTEL_HOST=http://langfuse-web:3000
# [OPTIONAL] Langfuse Bridge base URL。
LANGFUSE_BASE_URL=http://langfuse-web:3000

