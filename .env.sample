# Deployment
PUBLIC_HOST=192.168.1.100

# Open WebUI
# Generate with: openssl rand -hex 32
OPEN_WEBUI_PUBLIC_URL=http://${PUBLIC_HOST}:31001
OPEN_WEBUI_SECRET_KEY=
OPEN_WEBUI_API_KEY="<Settings - Account - API key of Open WebUI>"

# Hermes Agent
DISCORD_BOT_TOKEN="<Bot - Token>"
DISCORD_ALLOWED_USERS="<User ID 1>,<User ID 2>"
DISCORD_ALLOWED_CHANNELS="<Channel ID 1>,<Channel ID 2>"
DISCORD_HOME_CHANNEL="<Home Channel ID>"
DISCORD_HOME_CHANNEL_NAME=general

# Nextcloud
NEXTCLOUD_HOST_PORT=31012
NEXTCLOUD_PUBLIC_URL=http://${PUBLIC_HOST}:31012
NEXTCLOUD_TRUSTED_DOMAINS="localhost 127.0.0.1 ${PUBLIC_HOST} nextcloud"
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD="<change-me>"
NEXTCLOUD_MYSQL_ROOT_PASSWORD="<change-me>"
NEXTCLOUD_MYSQL_PASSWORD="<change-me>"
NEXTCLOUD_OIDC_CLIENT_SECRET=nextcloud-oauth-client-secret-key
NEXTCLOUD_OIDC_DISCOVERY_URL=http://${PUBLIC_HOST}:30000/realms/inferlab/.well-known/openid-configuration
NEXTCLOUD_OIDC_SCOPE="openid profile email"
NEXTCLOUD_OIDC_ALLOW_INSECURE_HTTP=true
NEXTCLOUD_ALLOW_LOCAL_REMOTE_SERVERS=true

# OIKB: Nextcloud -> Open WebUI Knowledge
NEXTCLOUD_OPENWEBUI_KB_ID=<Open WebUI Knowledge Base UUID>
OIKB_API_KEY=<change-me>
OIKB_HOST_PORT=31013
OIKB_NEXTCLOUD_SOURCE=/nextcloud/data/admin/files/Documents
OIKB_NEXTCLOUD_USER=admin
OIKB_NEXTCLOUD_PASSWORD=" <Nextcloud app password recommended>"

# RAGFlow
RAGFLOW_HOST_PORT=31008
RAGFLOW_API_KEY=<RAGFlow - User avatar - API key>
RAGFLOW_CHAT_IDS=<label:chat_id>
RAGFLOW_AGENT_IDS=<label:agent_id>
RAGFLOW_OPENAI_BASE_URL=http://litellm:4000/v1
RAGFLOW_OPENAI_API_KEY=sk-litellm-master-key
RAGFLOW_VISION_MODEL=gemma3:31b
RAGFLOW_VISION_BASE_URL=http://litellm:4000/v1
RAGFLOW_VISION_API_KEY=sk-litellm-master-key
RAGFLOW_TTS_MODEL=tts-1
RAGFLOW_TTS_BASE_URL=http://openai-edge-tts:5050/v1
RAGFLOW_TTS_API_KEY=openai-edge-tts-api-secret-key

CARBONE_GATEWAY_PUBLIC_URL=http://localhost:31010
CLOUDFLARE_TUNNEL_TOKEN=

COUCHDB_USER=obsidian
COUCHDB_PASSWORD=sk-obsidian-db-key
