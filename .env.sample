RPM_REPO_NGINX_IMAGE_TAG=1.31.3-alpine
# [OPTIONAL] RPM repo host公開port。
RPM_REPO_HTTP_HOST_PORT=31203
# [OPTIONAL] reprepro image。
DEB_REPREPRO_IMAGE=docker.io/eilandert/reprepro@sha256:7e448608d5ff4d22e6ddf2ddcdc2102f2f8abefa59c4324a6dc345881b1a586f
# [OPTIONAL] DEB codename。
DEB_CODENAME=stable
# [OPTIONAL] DEB architectures。
DEB_ARCHITECTURES="amd64 arm64"
# [OPTIONAL] DEB component。
DEB_COMPONENT=main
# [OPTIONAL] DEB distribution。
DEB_DISTRIBUTION=stable
# [OPTIONAL] DEB label。
DEB_LABEL=InferLab
# [OPTIONAL] DEB origin。
DEB_ORIGIN=InferLab
# [OPTIONAL] DEB repo nginx image tag。
DEB_REPO_NGINX_IMAGE_TAG=1.31.3-alpine
# [OPTIONAL] DEB repo host公開port。
DEB_REPO_HTTP_HOST_PORT=31204

