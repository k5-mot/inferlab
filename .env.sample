### 31-bookstack
### ------------------------------
# [OPTIONAL] BookStack PUID。
BOOKSTACK_PUID=1000
# [OPTIONAL] BookStack PGID。
BOOKSTACK_PGID=1000
# [OPTIONAL] BookStack timezone。
BOOKSTACK_TZ=Asia/Tokyo
# [OPTIONAL] BookStack public URL。
BOOKSTACK_PUBLIC_URL=http://localhost:33100
# [REQUIRED] BookStack app key。
BOOKSTACK_APP_KEY=base64:8Xpuu6D/PftKO7GAZWORsKIw1rveODqBcEyU8HKaxCA=
# [OPTIONAL] BookStack DB user。
BOOKSTACK_DB_USER=bookstack
# [REQUIRED] BookStack DB password。
BOOKSTACK_DB_PASSWORD=bookstack_password
# [OPTIONAL] BookStack DB name。
BOOKSTACK_DB_DATABASE=bookstack
# [REQUIRED] BookStack DB root password。
BOOKSTACK_DB_ROOT_PASSWORD=bookstack_root_password
