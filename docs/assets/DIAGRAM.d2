vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 101
  }
}

direction: down

users: {
  label: "Users"
  shape: person
  style: {
    fill: "#f8fafc"
    stroke: "#475569"
  }
}

public_host: {
  label: "PUBLIC_HOST"
  style: {
    fill: "#eef2ff"
    stroke: "#4f46e5"
    stroke-width: 2
  }
}

service_catalog: {
  label: "Inferlab Services"
  direction: down
  grid-columns: 1
  style: {
    fill: "#f8fafc"
    stroke: "#334155"
    stroke-width: 2
  }

  row_1: {
    label: "Infrastructure Layer"
    direction: right
    grid-columns: 4
    style: {
      fill: "#ffffff"
      stroke: "#cbd5e1"
    }

    00_common: {
      label: "00-common"
      grid-columns: 2
      style: {
        fill: "#f0fdfa"
        stroke: "#0f766e"
        stroke-width: 2
      }

      homepage: {
        label: "Homepage\n30000"
        icon: "../../00-common/homepage/icons/homepage.png"
        style: {
          fill: "#ffffff"
          stroke: "#0f766e"
        }
      }

      whoami: {
        label: "whoami\n30003"
        icon: "../../00-common/homepage/icons/docker.png"
        style: {
          fill: "#ffffff"
          stroke: "#0f766e"
        }
      }
    }

    01_keycloak: {
      label: "01-keycloak"
      grid-columns: 1
      style: {
        fill: "#f0fdfa"
        stroke: "#0f766e"
        stroke-width: 2
      }

      keycloak: {
        label: "Keycloak\n30001 / 30002"
        icon: "../../00-common/homepage/icons/keycloak.png"
        style: {
          fill: "#ffffff"
          stroke: "#0f766e"
        }
      }
    }

    02_pubnet: {
      label: "02-pubnet"
      grid-columns: 1
      style: {
        fill: "#eef2ff"
        stroke: "#4f46e5"
        stroke-width: 2
      }

      cloudflare: {
        label: "Cloudflare Tunnel"
        icon: "../../00-common/homepage/icons/cloudflared.png"
        style: {
          fill: "#ffffff"
          stroke: "#4f46e5"
        }
      }
    }

    12_registry: {
      label: "12-registry"
      grid-columns: 3
      style: {
        fill: "#f0f9ff"
        stroke: "#0284c7"
        stroke-width: 2
      }

      docker_registry: {
        label: "Docker Registry\n31205"
        icon: "../../00-common/homepage/icons/docker.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
        }
      }

      pypiserver: {
        label: "PyPI\n31200"
        icon: "../../00-common/homepage/icons/pypi.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
        }
      }

      verdaccio: {
        label: "Verdaccio\n31201"
        icon: "../../00-common/homepage/icons/verdaccio.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
        }
      }

      harbor: {
        label: "Code Marketplace\n31202"
        icon: "../../00-common/homepage/icons/visual-studio-code.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
        }
      }

      rpm_repo: {
        label: "RPM Repository\n31203"
        icon: "../../00-common/homepage/icons/redhat-linux.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
        }
      }

      deb_repo: {
        label: "APT Repository\n31204"
        icon: "../../00-common/homepage/icons/debian-linux.png"
        style: {
          fill: "#ffffff"
          stroke: "#0284c7"
        }
      }
    }

    40_obsidian: {
      label: "40-obsidian"
      grid-columns: 1
      style: {
        fill: "#f8fafc"
        stroke: "#475569"
        stroke-width: 2
      }

      couchdb: {
        label: "CouchDB\n34000"
        icon: "../../00-common/homepage/icons/couchdb.png"
        style: {
          fill: "#ffffff"
          stroke: "#475569"
        }
      }
    }
  }

  row_2: {
    label: "Application Layer"
    direction: right
    grid-columns: 4
    style: {
      fill: "#ffffff"
      stroke: "#cbd5e1"
    }

    10_inference: {
      label: "10-inference"
      grid-columns: 3
      style: {
        fill: "#fefce8"
        stroke: "#a16207"
        stroke-width: 2
      }

      hermes_agent: {
        label: "Hermes-Agent\n31001"
        icon: "../../00-common/homepage/icons/hermes-icon.png"
