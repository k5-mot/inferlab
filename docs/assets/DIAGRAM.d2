users -> public_host: "access"
public_host -> service_catalog: "published services"

# service_catalog.row_1 -> service_catalog.row_3: "認証・パッケージ提供"
# service_catalog.row_3 -> service_catalog.row_4: "観測"

service_catalog.row_2.10_inference.litellm -> service_catalog.row_2.10_inference.tei
service_catalog.row_2.10_inference.litellm -> service_catalog.row_2.10_inference.ollama
service_catalog.row_2.10_inference.litellm -> service_catalog.row_2.10_inference.openrouter
service_catalog.row_2.10_inference.litellm -> service_catalog.row_2.10_inference.google_ai_studio
service_catalog.row_2.10_inference.litellm -> service_catalog.row_2.10_inference.kokoro
service_catalog.row_2.10_inference.litellm -> service_catalog.row_2.10_inference.cerebras
service_catalog.row_2.10_inference.hermes_agent -> service_catalog.row_2.10_inference.litellm
service_catalog.row_2.10_inference.openclaw -> service_catalog.row_2.10_inference.litellm
service_catalog.row_3.20_owui.open_webui -> service_catalog.row_3.20_owui.open_terminal
service_catalog.row_3.20_owui.open_webui -> service_catalog.row_3.20_owui.mcpo
service_catalog.row_3.20_owui.open_webui -> service_catalog.row_3.20_owui.searxng
service_catalog.row_3.20_owui.open_webui -> service_catalog.row_3.20_owui.oikb
service_catalog.row_3.20_owui.oikb -> service_catalog.row_3.20_owui.oikb_rustfs
service_catalog.row_3.21_dify.dify -> service_catalog.row_3.21_dify.rustfs
service_catalog.row_3.22_ragflow.ragflow -> service_catalog.row_3.22_ragflow.rustfs
# service_catalog.row_3.20_owui.open_webui -> service_catalog.row_2.11_rag.docling
# service_catalog.row_3.20_owui.open_webui -> service_catalog.row_2.11_rag.qdrant

service_catalog.row_3.20_owui.oikb -> service_catalog.row_3.30_nextcloud.nextcloud

service_catalog.row_4.50_o11y.grafana -> service_catalog.row_4.50_o11y.prometheus
