users -> public_host: "access"
public_host -> service_catalog: "published services"

service_catalog.row_1 -> service_catalog.row_2: "認証・パッケージ提供"
service_catalog.row_2 -> service_catalog.row_3: "観測"

service_catalog.row_2.10_inference.litellm -> service_catalog.row_2.10_inference.tei
