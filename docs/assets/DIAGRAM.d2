vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 101
  }
}

direction: down

users: {
  label: "Users"
  shape: person
  style: {
    fill: "#f8fafc"
    stroke: "#475569"
  }
}

public_host: {
  label: "PUBLIC_HOST"
  style: {
    fill: "#eef2ff"
    stroke: "#4f46e5"
    stroke-width: 2
  }
}

service_catalog: {
  label: "Inferlab Services"
  direction: down
  grid-columns: 1
  style: {
    fill: "#f8fafc"
    stroke: "#334155"
    stroke-width: 2
  }

  row_1: {
    label: "Infrastructure Layer\n(ポータル・認証・外部公開)"
    direction: right
    grid-columns: 4
    style: {
      fill: "#ffffff"
      stroke: "#cbd5e1"
    }

    00_common: {
      label: "00-common"
      grid-columns: 2
      style: {
        fill: "#f0fdfa"
        stroke: "#0f766e"
        stroke-width: 2
      }

      homepage: {
        label: "Homepage\n30000"
        icon: "../../00-common/homepage/icons/homepage.png"
        style: {
          fill: "#ffffff"
          stroke: "#0f766e"
        }
      }

      whoami: {
        label: "whoami\n30003"
        icon: "../../00-common/homepage/icons/docker.png"
        style: {
          fill: "#ffffff"
          stroke: "#0f766e"
        }
      }
    }

    01_keycloak: {
      label: "01-keycloak"
