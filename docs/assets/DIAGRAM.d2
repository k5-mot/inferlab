        icon: "../../00-common/homepage/icons/kokoro-web.png"
        style: {
          fill: "#ffffff"
          stroke: "#a16207"
        }
      }

      openrouter: {
        label: "OpenRouter\n外部サービス"
        icon: "../../00-common/homepage/icons/open-router.png"
        shape: cloud
        style: {
          fill: "#f8fafc"
          stroke: "#64748b"
          stroke-dash: 4
        }
      }

      google_ai_studio: {
        label: "Google AI Studio\n外部サービス"
        icon: "../../00-common/homepage/icons/google-gemini.png"
        shape: cloud
        style: {
          fill: "#f8fafc"
          stroke: "#64748b"
          stroke-dash: 4
        }
      }
    }

    11_rag: {
      label: "11-rag"
